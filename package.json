{
  "name": "risu-alpha",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "types": "wrangler types",
    "css-types": "tcm -s -a -p \"src/app/**/*.module.css\"",
    "build": "wrangler types && npm run css-types && tsc -b && vite build",
    "test": "vitest run",
    "check": "wrangler types && npm run css-types && tsc -b && eslint . && stylelint \"src/**/*.css\" && vitest run",
    "db:migrate:local": "wrangler d1 migrations apply risu-alpha --local",
    "db:migrate:remote": "wrangler d1 migrations apply risu-alpha --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/gowun-batang": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "fflate": "0.8.3",
    "hash-wasm": "4.12.0",
    "hono": "4.13.9",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "stylelint": "17.15.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typed-css-modules": "0.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.141.0"
  }
}
