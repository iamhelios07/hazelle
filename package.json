{
  "name": "risu-alpha",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "types": "wrangler types",
    "build": "wrangler types && tsc -b && vite build",
    "test": "vitest run",
    "check": "wrangler types && tsc -b && eslint . && vitest run",
    "db:migrate:local": "wrangler d1 migrations apply risu-alpha --local",
    "db:migrate:remote": "wrangler d1 migrations apply risu-alpha --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "hono": "4.13.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.141.0"
  }
}
