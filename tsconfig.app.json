{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "allowArbitraryExtensions": true
  },
  "include": [
    "src/app",
    "src/tool-api",
    "src/sandbox",
    "src/connectors",
    "src/engine",
    "src/model",
    "src/runtime",
    "src/vault"
  ],
  "exclude": ["src/runtime/testing.ts", "src/runtime/**/*.test.ts"]
}
