/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Every file under /assets has a content hash in its name, so a changed file is a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
