# Cloudflare's proxy in Full (strict) mode is the only client: it terminates the public TLS and checks this origin
# against the Origin CA certificate mounted below. With an explicit certificate Caddy runs no ACME for the name.
hazelle.app {
	tls /etc/caddy/origin.pem /etc/caddy/origin.key
	reverse_proxy app:8080 {
		# Replies stream as they are written; buffering would hold them until the end.
		flush_interval -1
		# Above the app's 15-minute limit on a provider call.
		transport http {
			read_timeout 20m
			write_timeout 20m
		}
	}
}
