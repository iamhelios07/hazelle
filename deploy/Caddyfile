# Caddy's own Let's Encrypt certificate serves either edge (infra/ variable edge): visitors directly, or Cloudflare's
# proxy in Full (strict), which trusts it. Its ACME account and certificate live in the caddy volume; a lost volume
# issues again and counts against Let's Encrypt's weekly limit.
hazelle.app {
	reverse_proxy app:8080 {
		# Replies stream as they are written; buffering would hold them until the end.
		flush_interval -1
		# Above the app's 15-minute limit on a provider call.
		transport http {
			read_timeout 20m
			write_timeout 20m
		}
	}
}
