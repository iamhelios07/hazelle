{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "risu-alpha",
  "main": "src/server/main.ts",
  "compatibility_date": "2026-09-25",
  "send_metrics": false,
  // Without this flag request.signal never fires on client disconnect, so a closed tab would not end
  // a relayed call (tech-spec §6).
  "compatibility_flags": ["enable_request_signal"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "risu-alpha",
      "database_id": "abe6fd8a-7c52-4d19-aa8a-b18065dfee1e",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "STREAMS", "class_name": "ReplyStream" },
      { "name": "RELAY", "class_name": "Relay" },
      { "name": "STORES", "class_name": "AccountStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ReplyStream"] },
    { "tag": "v2", "new_sqlite_classes": ["Relay"] },
    { "tag": "v3", "new_sqlite_classes": ["AccountStore"] }
  ],
  // CALLS throttles provider calls per account (src/server/session.ts). BOT_CALLS limits a chat's bot's own model
  // calls, keyed account:chat (src/server/streams.ts), so a script in a loop cannot spend the user's money unseen.
  // namespace_id is any integer unique in the Cloudflare account. period takes 10 or 60 only.
  "ratelimits": [
    { "name": "CALLS", "namespace_id": "1001", "simple": { "limit": 240, "period": 60 } },
    { "name": "BOT_CALLS", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  // The operator's account id (src/server/http.ts). Empty names no one.
  "vars": { "ADMIN_ACCOUNT": "" },
  // Hourly: the sweep of pictures whose account is gone, and the delete of reports and log rows past their year
  // (src/server/main.ts).
  "triggers": { "crons": ["17 * * * *"] },
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "risu-alpha-files"
    }
  ]
}
